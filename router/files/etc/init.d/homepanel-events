#!/bin/sh /etc/rc.common
#
# homepanel-events — watcher событий hostapd: при подключении/отключении
# клиента сразу запускает отправку снимка агентом.
#
# Спека: docs/superpowers/specs/2026-10-25-router-v2-design.md (§9)

START=96
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/ucode /usr/share/ucode/homepanel/events.uc
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	:
}
